{
  "name": "lolshorts",
  "version": "1.2.0",
  "description": "League of Legends auto-recording and editing desktop app with YouTube integration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug --no-bundle",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src tests/e2e --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "verify:frontend": "npm run lint && npm run typecheck && npm run build && npm run test:unit",
    "verify:non-game-readiness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-non-game-readiness.ps1",
    "test:media-regression": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-media-regression.ps1",
    "test:supabase": "npx -y deno test supabase/functions/quota/logic.test.ts",
    "test:field-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-field-evidence-tools.ps1",
    "verify:release-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-contract.ps1",
    "verify:release-preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-field-qa-preflight.ps1",
    "audit:all": "npm audit",
    "audit:runtime": "npm audit --omit=dev",
    "audit:moderate": "npm audit --omit=dev --audit-level=moderate",
    "sbom": "npx @cyclonedx/cyclonedx-npm --output-file sbom.json",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.43.0",
    "@supabase/supabase-js": "2.80.0",
    "@tanstack/react-router": "^1.94.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^25.6.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.2.4",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.56.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^6.0.5"
  },
  "overrides": {
    "seroval": "^1.6.2",
    "ws": "^8.21.3"
  },
  "packageManager": "npm@11.6.3",
  "engines": {
    "node": "24.2.x",
    "npm": "11.6.3"
  }
}
