# LoLShorts Environment Configuration
# Copy this file to .env and update with your production values
# IMPORTANT: Never commit .env file to version control

# =============================================================================
# FRONTEND (Vite) - Must have VITE_ prefix to be exposed to browser
# =============================================================================

# Supabase Configuration (Required)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Rust receives the same public values at compile time in release builds.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key

# Frontend error reporting (Optional)
# VITE_SENTRY_DSN=https://your-frontend-sentry-dsn

# =============================================================================
# BACKEND (Rust/Tauri) - Server-side only, not exposed to browser
# =============================================================================

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# YouTube OAuth2 Configuration (Required for YouTube uploads)
# Get these from Google Cloud Console: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your-youtube-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:9090/oauth/callback

# Database Configuration (for local Supabase development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
